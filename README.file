import requests

NOTION_TOKEN = "secret_YOUR_NOTION_INTEGRATION_TOKEN"
DATABASE_ID = "YOUR_DATABASE_ID"

headers = {
    "Authorization": f"Bearer {NOTION_TOKEN}",
    "Content-Type": "application/json",
    "Notion-Version": "2022-06-28"  # 최신 API 버전
}

# 1. Create (페이지/데이터 생성)
def create_page(title_text):
    url = "https://api.notion.com/v1/pages"
    payload = {
        "parent": {"database_id": DATABASE_ID},
        "properties": {
            "Title": {  # 데이터베이스의 제목 컬럼 이름에 맞게 수정
                "title": [
                    {"text": {"content": title_text}}
                ]
            }
        }
    }
    response = requests.post(url, json=payload, headers=headers)
    return response.json()

# 2. Read (데이터베이스 조회)
def read_database():
    url = f"https://api.notion.com/v1/databases/{DATABASE_ID}/query"
    response = requests.post(url, headers=headers)
    return response.json()

# 3. Update (페이지/데이터 수정)
def update_page(page_id, new_title):
    url = f"https://api.notion.com/v1/pages/{page_id}"
    payload = {
        "properties": {
            "Title": {
                "title": [
                    {"text": {"content": new_title}}
                ]
            }
        }
    }
    response = requests.patch(url, json=payload, headers=headers)
    return response.json()

# 4. Delete (페이지 보관/삭제 처리)
# 노션 API는 물리적 완전 삭제 대신 'archived: true'로 삭제 처리합니다.
def delete_page(page_id):
    url = f"https://api.notion.com/v1/pages/{page_id}"
    payload = {
        "archived": True
    }
    response = requests.patch(url, json=payload, headers=headers)
    return response.json()
